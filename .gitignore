# Служебное
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.DS_Store

# Сборка и установка
build/
dist/
*.egg-info/
.venv/
venv/

# Временные файлы Word: появляются, пока документ открыт в редакторе.
~$*

# Результаты прогонов
*.jsonl
*.parquet
chunks/

# Документы Word сюда не попадают никогда: тесты собирают свои .docx из
# XML по месту, а любой .docx в рабочей копии — это чей-то настоящий
# документ, случайно положенный рядом.
*.docx
*.doc
